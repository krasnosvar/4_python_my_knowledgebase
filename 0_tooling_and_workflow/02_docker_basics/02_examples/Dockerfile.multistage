# Пример multi-stage build: этап сборки отделён от финального минимального образа.
# Для этого простого приложения выигрыш в размере невелик, но паттерн важен
# для зависимостей с C-расширениями (numpy, psycopg2 без -binary, и т.д.),
# где на этапе сборки нужны компиляторы, а в финальном образе — нет.

# --- этап сборки: устанавливаем зависимости в изолированную папку ---
FROM python:3.12-slim AS builder

WORKDIR /app
COPY app/requirements.txt .
RUN pip install --no-cache-dir --target=/deps -r requirements.txt

# --- финальный этап: только рантайм и уже собранные зависимости ---
FROM python:3.12-slim

WORKDIR /app
COPY --from=builder /deps /usr/local/lib/python3.12/site-packages
COPY app/ .

EXPOSE 8000

# python -m uvicorn, а не просто "uvicorn": при pip install --target
# консольный скрипт uvicorn не создаётся, доступен только сам модуль.
CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
